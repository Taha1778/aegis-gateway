# Node 24: node --env-file=.env dist/server.js
HOST=127.0.0.1
PORT=4310
DATABASE_PATH=data/aegis.sqlite
# Omit both keys for localhost-only demo. Set BOTH distinct keys for protected mode.
# GATEWAY_API_KEY=<minimum 24 characters>
# ADMIN_API_KEY=<different minimum 24 characters>
# Optional fixed HTTPS chat-completions endpoint; never supplied by API callers.
# UPSTREAM_URL=https://your-provider.example/v1/chat/completions
# UPSTREAM_API_KEY=...
# UPSTREAM_MODEL=...
